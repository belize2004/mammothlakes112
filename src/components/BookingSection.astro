---
import { property } from '../data/property';
---

<section id="booking" class="py-20 lg:py-28 bg-charcoal-900 border-t border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-white/10 gap-6">
      <div>
        <div class="text-xs font-mono text-alpenglow uppercase tracking-widest mb-3 flex items-center gap-2">
          <span>07 // DIRECT RESERVATIONS & LIVE CALENDAR</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
          Reserve Direct, <span class="italic font-normal text-alabaster-200">Zero Middleman Fees.</span>
        </h2>
      </div>
      <div class="text-xs font-mono text-alabaster-400">
        <span class="text-alpenglow font-bold">BEST RATE GUARANTEE</span> &bull; OFFICIAL SITE
      </div>
    </div>

    <!-- Direct Booking Advantage Banner -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
      <div class="p-4 rounded-alpine bg-charcoal-850 border border-white/10 flex items-start gap-3">
        <div class="p-2 rounded-alpine bg-alpenglow/15 text-alpenglow mt-0.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h4 class="font-display font-semibold text-sm text-white">Save 10% – 15% Directly</h4>
          <p class="text-xs text-alabaster-400 font-light mt-0.5">No platform service markups or traveler booking fees charged by third-party channels.</p>
        </div>
      </div>

      <div class="p-4 rounded-alpine bg-charcoal-850 border border-white/10 flex items-start gap-3">
        <div class="p-2 rounded-alpine bg-alpenglow/15 text-alpenglow mt-0.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h4 class="font-display font-semibold text-sm text-white">Live Real-Time Sync</h4>
          <p class="text-xs text-alabaster-400 font-light mt-0.5">Directly connected to our master reservation system for instant, guaranteed confirmation.</p>
        </div>
      </div>

      <div class="p-4 rounded-alpine bg-charcoal-850 border border-white/10 flex items-start gap-3">
        <div class="p-2 rounded-alpine bg-alpenglow/15 text-alpenglow mt-0.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h4 class="font-display font-semibold text-sm text-white">Direct Owner Support</h4>
          <p class="text-xs text-alabaster-400 font-light mt-0.5">Talk directly with Rog & Steph for custom dates, early drop-offs, and local tips.</p>
        </div>
      </div>
    </div>

    <!-- Booking & Calendar Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Instant Booking Quote Generator Container (5 cols) -->
      <div class="lg:col-span-5 bg-charcoal-950 border border-white/15 rounded-alpine p-6 sm:p-8 shadow-alpine">
        <div class="mb-6 pb-4 border-b border-white/10 flex justify-between items-center">
          <div>
            <span class="text-[10px] font-mono text-alpenglow uppercase tracking-widest block">INSTANT RESERVATION</span>
            <h3 class="font-display text-xl font-bold text-white">Calculate Rates & Book</h3>
          </div>
          <span class="text-xs font-mono px-2.5 py-1 rounded-alpine bg-alpenglow/20 text-alpenglow font-semibold">
            {property.specs.baseRate}
          </span>
        </div>

        <!-- Live OwnerRez Booking / Inquiry Widget -->
        <div class="ownerrez-container bg-white rounded-alpine p-3 text-charcoal-900 shadow-inner overflow-hidden min-h-[380px]">
          <div 
            class="ownerrez-widget" 
            data-propertyId={property.ownerRez.propertyId} 
            data-widget-type="Booking/Inquiry" 
            data-widgetId={property.ownerRez.bookingWidgetId}
          ></div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/10 text-center">
          <p class="text-xs text-alabaster-400 mb-2 font-light">
            Dates show blocked? Contact us directly—we may be able to shift personal stays!
          </p>
          <a href={`tel:${property.contact.phone}`} class="text-xs font-mono text-alpenglow hover:underline">
            Call Rog & Steph: {property.contact.phoneFormatted}
          </a>
        </div>
      </div>

      <!-- Live Multi-Month Availability Calendar (7 cols) -->
      <div class="lg:col-span-7 bg-charcoal-950 border border-white/15 rounded-alpine p-6 sm:p-8 shadow-alpine">
        <div class="mb-6 pb-4 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <span class="text-[10px] font-mono text-alpenglow uppercase tracking-widest block">LIVE AVAILABILITY</span>
            <h3 class="font-display text-xl font-bold text-white">Multi-Month Calendar</h3>
          </div>
          <div class="flex items-center gap-3 text-xs font-mono text-alabaster-400">
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> Available</span>
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-charcoal-700 inline-block"></span> Reserved</span>
          </div>
        </div>

        <!-- Live OwnerRez Multi-Month Calendar Widget -->
        <div class="ownerrez-container bg-white rounded-alpine p-3 text-charcoal-900 shadow-inner overflow-x-auto min-h-[420px]">
          <div 
            class="ownerrez-widget" 
            data-propertyId={property.ownerRez.propertyId} 
            data-widget-type="Multiple Month Calendar" 
            data-widgetId={property.ownerRez.calendarWidgetId}
          ></div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-alabaster-400">
          <span>CHECK-IN: {property.specs.checkIn} // CHECK-OUT: {property.specs.checkOut}</span>
          <span class="text-alpenglow">PERMIT: {property.permitNumber}</span>
        </div>
      </div>

    </div>

  </div>
</section>

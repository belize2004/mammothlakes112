---
import { property } from '../data/property';
---

<section id="booking" class="py-20 lg:py-28 bg-charcoal-900 border-t border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-white/10 gap-6">
      <div>
        <div class="text-xs font-mono text-alpenglow uppercase tracking-widest mb-3 flex items-center gap-2">
          <span>08 // DIRECT BOOKING & LIVE CALENDAR</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
          Reserve Direct, <span class="italic font-normal text-alabaster-200">Zero Middleman Fees.</span>
        </h2>
      </div>
      <div class="text-xs font-mono text-alabaster-400">
        <span class="text-alpenglow font-bold">OFFICIAL DIRECT RATES</span> &bull; 100% SECURE CHECKOUT
      </div>
    </div>

    <!-- Direct Booking Advantage Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
      <div class="p-4 rounded-alpine bg-charcoal-850 border border-white/10 flex items-start gap-3">
        <div class="p-2 rounded-alpine bg-alpenglow/15 text-alpenglow mt-0.5 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h4 class="font-display font-semibold text-sm text-white">Save 10% – 15% Directly</h4>
          <p class="text-xs text-alabaster-400 font-light mt-0.5">No traveler service markups or Airbnb/VRBO commission fees.</p>
        </div>
      </div>

      <div class="p-4 rounded-alpine bg-charcoal-850 border border-white/10 flex items-start gap-3">
        <div class="p-2 rounded-alpine bg-alpenglow/15 text-alpenglow mt-0.5 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h4 class="font-display font-semibold text-sm text-white">Guaranteed Availability</h4>
          <p class="text-xs text-alabaster-400 font-light mt-0.5">Instant booking confirmation directly with owners Roger & Stephanie.</p>
        </div>
      </div>

      <div class="p-4 rounded-alpine bg-charcoal-850 border border-white/10 flex items-start gap-3">
        <div class="p-2 rounded-alpine bg-alpenglow/15 text-alpenglow mt-0.5 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h4 class="font-display font-semibold text-sm text-white">Direct Owner Hospitality</h4>
          <p class="text-xs text-alabaster-400 font-light mt-0.5">Custom arrival timing, gear storage, and personalized mountain recommendations.</p>
        </div>
      </div>
    </div>

    <!-- Interactive Booking & Inquiry Engine Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Native Instant Quote & Reservation Form (6 cols) -->
      <div class="lg:col-span-6 bg-charcoal-950 border border-white/15 rounded-alpine p-6 sm:p-8 shadow-alpine">
        <div class="mb-6 pb-4 border-b border-white/10 flex justify-between items-center">
          <div>
            <span class="text-[10px] font-mono text-alpenglow uppercase tracking-widest block mb-1">RESERVATION CALCULATOR</span>
            <h3 class="font-display text-xl font-bold text-white">Direct Rate Quote</h3>
          </div>
          <div class="text-right">
            <span class="text-xs font-mono px-2.5 py-1 rounded-alpine bg-alpenglow/20 text-alpenglow font-semibold block">
              {property.specs.baseRate}
            </span>
          </div>
        </div>

        <!-- Custom Dark Form Inputs -->
        <form 
          id="direct-quote-form" 
          action={`https://app.ownerrez.com/quotes/new`} 
          method="get" 
          target="_blank"
          class="space-y-4"
        >
          <input type="hidden" name="propertyId" value={property.ownerRez.propertyId} />
          
          <!-- Date Pickers Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="check-in-date" class="block text-[11px] font-mono text-alabaster-300 uppercase tracking-wider mb-1.5">
                Check-in Date
              </label>
              <input 
                type="date" 
                id="check-in-date" 
                name="arrival"
                class="w-full bg-charcoal-900 border border-white/15 rounded-alpine px-3.5 py-2.5 text-sm font-mono text-white focus:outline-none focus:border-alpenglow transition-colors"
                required
              />
            </div>
            <div>
              <label for="check-out-date" class="block text-[11px] font-mono text-alabaster-300 uppercase tracking-wider mb-1.5">
                Check-out Date
              </label>
              <input 
                type="date" 
                id="check-out-date" 
                name="departure"
                class="w-full bg-charcoal-900 border border-white/15 rounded-alpine px-3.5 py-2.5 text-sm font-mono text-white focus:outline-none focus:border-alpenglow transition-colors"
                required
              />
            </div>
          </div>

          <!-- Guests & Pets Selection Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="guest-count" class="block text-[11px] font-mono text-alabaster-300 uppercase tracking-wider mb-1.5">
                Guests (Max 4)
              </label>
              <select 
                id="guest-count" 
                name="guests"
                class="w-full bg-charcoal-900 border border-white/15 rounded-alpine px-3.5 py-2.5 text-sm font-mono text-white focus:outline-none focus:border-alpenglow transition-colors"
              >
                <option value="1">1 Guest</option>
                <option value="2" selected>2 Guests (Ideal)</option>
                <option value="3">3 Guests</option>
                <option value="4">4 Guests (Max)</option>
              </select>
            </div>
            <div>
              <label for="pets-count" class="block text-[11px] font-mono text-alabaster-300 uppercase tracking-wider mb-1.5">
                Bringing a Dog?
              </label>
              <select 
                id="pets-count" 
                name="pets"
                class="w-full bg-charcoal-900 border border-white/15 rounded-alpine px-3.5 py-2.5 text-sm font-mono text-white focus:outline-none focus:border-alpenglow transition-colors"
              >
                <option value="0">No Dogs</option>
                <option value="1">1 Dog 🐾</option>
                <option value="2">2 Dogs 🐾</option>
              </select>
            </div>
          </div>

          <!-- Live Transparent Savings Callout -->
          <div class="p-4 rounded-alpine bg-charcoal-900 border border-white/10 space-y-2 mt-4 text-xs font-mono">
            <div class="flex justify-between text-alabaster-300">
              <span>Standard Nightly Rate:</span>
              <span class="text-white font-semibold">{property.specs.baseRate}</span>
            </div>
            <div class="flex justify-between text-alabaster-300">
              <span>Airbnb / VRBO Service Fees:</span>
              <span class="text-emerald-400 font-bold">$0 (Saved Directly)</span>
            </div>
            <div class="flex justify-between text-alabaster-300">
              <span>Reserved Front-Door Parking (2 spots):</span>
              <span class="text-white">Included Free</span>
            </div>
            <div class="flex justify-between text-alabaster-300">
              <span>Wood Stove Firewood & Jacuzzi:</span>
              <span class="text-white">Included Free</span>
            </div>
          </div>

          <!-- Primary Direct Booking CTA Button -->
          <button 
            type="submit" 
            class="w-full py-3.5 px-6 rounded-alpine bg-alpenglow hover:bg-alpenglow-hover font-mono text-sm uppercase tracking-wider font-bold text-white shadow-lg hover:shadow-alpenglow/30 transition-all duration-200 flex items-center justify-center gap-2 mt-4"
          >
            <span>Proceed to Secure Direct Checkout</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <!-- Direct Host Contact Sub-bar -->
        <div class="mt-6 pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-alabaster-400">
          <span>Need flexible dates?</span>
          <a href={`tel:${property.contact.phone}`} class="text-alpenglow hover:underline font-semibold">
            Call Rog & Steph: {property.contact.phoneFormatted}
          </a>
        </div>
      </div>

      <!-- Right Column: Live Calendar & Direct Host Booking Support (6 cols) -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Live Calendar Container with Dark Ambient Wrapper -->
        <div class="bg-charcoal-950 border border-white/15 rounded-alpine p-6 sm:p-8 shadow-alpine">
          <div class="mb-6 pb-4 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-mono text-alpenglow uppercase tracking-widest block mb-1">LIVE AVAILABILITY</span>
              <h3 class="font-display text-xl font-bold text-white">Multi-Month Calendar</h3>
            </div>
            <div class="flex items-center gap-3 text-xs font-mono text-alabaster-400">
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span> Available</span>
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-charcoal-700 inline-block"></span> Booked</span>
            </div>
          </div>

          <!-- Seamless OwnerRez Calendar Container with Dark Frame -->
          <div class="rounded-alpine border border-white/10 overflow-hidden bg-white/95 p-2 shadow-inner">
            <div 
              class="ownerrez-widget" 
              data-propertyId={property.ownerRez.propertyId} 
              data-widget-type="Multiple Month Calendar" 
              data-widgetId={property.ownerRez.calendarWidgetId}
            ></div>
          </div>

          <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono text-alabaster-400">
            <span>CHECK-IN: {property.specs.checkIn} // OUT: {property.specs.checkOut}</span>
            <span class="text-alpenglow">PERMIT: {property.permitNumber}</span>
          </div>
        </div>

        <!-- Personal Host Direct Guarantee Card -->
        <div class="p-6 rounded-alpine bg-charcoal-850 border border-white/10 flex items-start gap-4">
          <div class="w-10 h-10 rounded-alpine bg-alpenglow/15 border border-alpenglow/30 flex items-center justify-center text-alpenglow flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <h4 class="font-display font-bold text-white text-base mb-1">Direct Host Inquiries & Custom Stays</h4>
            <p class="text-xs text-alabaster-300 font-light leading-relaxed mb-3">
              Even if your preferred dates show blocked, feel free to reach out to Rog & Steph directly. Dates may be reserved for personal use and can often be shifted to welcome your stay!
            </p>
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
              <a href={`tel:${property.contact.phone}`} class="text-white hover:text-alpenglow transition-colors">
                📞 {property.contact.phoneFormatted}
              </a>
              <span class="text-white/20">&bull;</span>
              <a href={`mailto:${property.contact.email}`} class="text-white hover:text-alpenglow transition-colors">
                ✉️ {property.contact.email}
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Set default minimum dates for check-in/out
  const today = new Date().toISOString().split('T')[0];
  const checkInInput = document.getElementById('check-in-date') as HTMLInputElement | null;
  const checkOutInput = document.getElementById('check-out-date') as HTMLInputElement | null;

  if (checkInInput) {
    checkInInput.min = today;
    checkInInput.addEventListener('change', () => {
      if (checkOutInput && checkInInput.value) {
        checkOutInput.min = checkInInput.value;
      }
    });
  }
</script>

---
import { photos, photoCategories } from '../data/photos';
---

<section id="residence" class="py-20 lg:py-28 bg-charcoal-950 border-t border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-white/10 gap-6">
      <div>
        <div class="text-xs font-mono text-alpenglow uppercase tracking-widest mb-3 flex items-center gap-2">
          <span>03 // THE RESIDENCE TOUR</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
          A Tour of <span class="italic font-normal text-alabaster-200">Unit 112.</span>
        </h2>
      </div>
      <div class="text-sm font-mono text-alabaster-400">
        <span class="text-white font-semibold">{photos.length} High-Res Frames</span> &bull; 612 SQ FT &bull; Studio + Loft
      </div>
    </div>

    <!-- Category Filter Tabs (Interactive) -->
    <div class="flex flex-wrap gap-2 mb-10 pb-4 border-b border-white/5" id="gallery-tabs">
      {photoCategories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat.id}
          class={`gallery-tab px-4 py-2 text-xs font-mono uppercase tracking-wider rounded-alpine transition-all duration-200 border ${
            idx === 0 
              ? 'bg-alpenglow text-white border-alpenglow font-semibold active-tab' 
              : 'bg-charcoal-900 text-alabaster-300 border-white/10 hover:border-white/30 hover:text-white'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Photo Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="photo-grid">
      {photos.map((photo, index) => (
        <div 
          class="photo-card group relative bg-charcoal-900 border border-white/10 rounded-alpine overflow-hidden cursor-pointer transition-all duration-300 hover:border-alpenglow/60 hover:shadow-alpine"
          data-category={photo.category}
          data-index={index}
        >
          <div class="relative aspect-[16/11] w-full overflow-hidden bg-charcoal-950">
            <img 
              src={photo.url} 
              alt={photo.alt}
              class="w-full h-full object-cover object-center transform transition-transform duration-500 group-hover:scale-105"
              loading={index < 6 ? "eager" : "lazy"}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950/90 via-charcoal-950/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
            
            <!-- Hover Zoom Icon -->
            <div class="absolute top-3 right-3 w-8 h-8 rounded-alpine bg-charcoal-900/80 border border-white/20 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-opacity">
              <svg class="w-4 h-4 text-alpenglow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
              </svg>
            </div>

            <!-- Bottom Title Badge -->
            <div class="absolute bottom-3 left-3 right-3">
              <span class="text-xs font-mono text-alpenglow uppercase tracking-wider block mb-0.5">
                {photo.category.toUpperCase()}
              </span>
              <h4 class="font-display text-base font-semibold text-white truncate">
                {photo.title}
              </h4>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>

  <!-- Fullscreen Lightbox Modal -->
  <div 
    id="lightbox-modal" 
    class="fixed inset-0 z-[100] hidden bg-charcoal-950/95 backdrop-blur-xl flex flex-col justify-between p-4 sm:p-8 select-none"
    role="dialog"
    aria-modal="true"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between max-w-7xl w-full mx-auto pb-4 border-b border-white/10">
      <div class="flex items-center gap-3">
        <span class="text-xs font-mono text-alpenglow" id="lightbox-counter">1 / 27</span>
        <span class="text-white/30">&bull;</span>
        <span class="text-sm font-display font-medium text-white truncate" id="lightbox-title">Title</span>
      </div>
      <button 
        type="button" 
        id="lightbox-close"
        class="p-2 text-alabaster-300 hover:text-white border border-white/15 rounded-alpine bg-charcoal-900 hover:bg-white/10 transition-colors"
        aria-label="Close Lightbox"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Main Image Viewport -->
    <div class="relative flex-grow flex items-center justify-center my-4 overflow-hidden">
      <!-- Previous Button -->
      <button 
        type="button" 
        id="lightbox-prev"
        class="absolute left-2 sm:left-6 z-10 p-3 text-white border border-white/20 rounded-alpine bg-charcoal-900/80 hover:bg-alpenglow hover:border-alpenglow transition-colors"
        aria-label="Previous Image"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Central Image -->
      <div class="max-w-5xl max-h-[75vh] w-full flex items-center justify-center p-2">
        <img 
          id="lightbox-img" 
          src="" 
          alt="" 
          class="max-h-[72vh] max-w-full object-contain rounded-alpine border border-white/10 shadow-2xl transition-all duration-200"
        />
      </div>

      <!-- Next Button -->
      <button 
        type="button" 
        id="lightbox-next"
        class="absolute right-2 sm:right-6 z-10 p-3 text-white border border-white/20 rounded-alpine bg-charcoal-900/80 hover:bg-alpenglow hover:border-alpenglow transition-colors"
        aria-label="Next Image"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Modal Footer Caption -->
    <div class="max-w-7xl w-full mx-auto pt-4 border-t border-white/10 text-center text-xs font-mono text-alabaster-400">
      <span id="lightbox-alt">Caption</span> &bull; Use arrow keys (← / →) or Esc to close
    </div>
  </div>
</section>

<script define:vars={{ photosData: photos }}>
  let currentIndex = 0;
  let activeCategory = 'all';

  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img');
  const modalTitle = document.getElementById('lightbox-title');
  const modalAlt = document.getElementById('lightbox-alt');
  const modalCounter = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const tabs = document.querySelectorAll('.gallery-tab');
  const cards = document.querySelectorAll('.photo-card');

  // Category Tab Filtering
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('bg-alpenglow', 'text-white', 'border-alpenglow', 'font-semibold', 'active-tab');
        t.classList.add('bg-charcoal-900', 'text-alabaster-300', 'border-white/10');
      });
      tab.classList.add('bg-alpenglow', 'text-white', 'border-alpenglow', 'font-semibold', 'active-tab');
      tab.classList.remove('bg-charcoal-900', 'text-alabaster-300', 'border-white/10');

      const category = tab.getAttribute('data-category');
      activeCategory = category || 'all';

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (activeCategory === 'all' || cardCat === activeCategory) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Open Lightbox
  function openLightbox(index) {
    currentIndex = index;
    updateLightbox();
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    modal?.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  function updateLightbox() {
    const item = photosData[currentIndex];
    if (!item || !modalImg || !modalTitle || !modalAlt || !modalCounter) return;

    modalImg.src = item.url;
    modalImg.alt = item.alt;
    modalTitle.textContent = item.title;
    modalAlt.textContent = item.alt;
    modalCounter.textContent = `${currentIndex + 1} / ${photosData.length}`;
  }

  function nextImage() {
    currentIndex = (currentIndex + 1) % photosData.length;
    updateLightbox();
  }

  function prevImage() {
    currentIndex = (currentIndex - 1 + photosData.length) % photosData.length;
    updateLightbox();
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const idx = parseInt(card.getAttribute('data-index') || '0', 10);
      openLightbox(idx);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  nextBtn?.addEventListener('click', nextImage);
  prevBtn?.addEventListener('click', prevImage);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (modal && !modal.classList.contains('hidden')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    }
  });
</script>

---
import { amenityCategories } from '../data/amenities';
---

<section class="py-20 lg:py-28 bg-charcoal-950 border-t border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-6 border-b border-white/10 gap-6">
      <div>
        <div class="text-xs font-mono text-alpenglow uppercase tracking-widest mb-3 flex items-center gap-2">
          <span>04 // COMPREHENSIVE AMENITY INDEX</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
          Comfort, <span class="italic font-normal text-alabaster-200">Dialed-In Details.</span>
        </h2>
      </div>
      <p class="text-sm sm:text-base text-alabaster-300 max-w-md font-light">
        Every amenity in Unit 112 is chosen for high-alpine endurance, culinary ease, and effortless recovery.
      </p>
    </div>

    <!-- Categorized Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {amenityCategories.map((category) => (
        <div class="bg-charcoal-900 border border-white/10 rounded-alpine p-7 flex flex-col justify-between hover:border-white/20 transition-all duration-200">
          <div>
            <!-- Category Title & Description -->
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/10">
              <h3 class="font-display text-xl font-bold text-white">
                {category.name}
              </h3>
              <span class="w-2 h-2 rounded-full bg-alpenglow"></span>
            </div>
            <p class="text-xs text-alabaster-400 mb-6 font-light">
              {category.description}
            </p>

            <!-- Items List -->
            <ul class="space-y-4">
              {category.items.map((item) => (
                <li class="flex flex-col gap-1">
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-sm font-medium text-white flex items-center gap-2">
                      <span class="w-1 h-1 rounded-full bg-alabaster-400"></span>
                      {item.title}
                    </span>
                    {item.badge && (
                      <span class="px-2 py-0.5 rounded-alpine bg-white/10 border border-white/15 text-[9px] font-mono text-alabaster-200 uppercase tracking-widest">
                        {item.badge}
                      </span>
                    )}
                  </div>
                  {item.detail && (
                    <span class="text-xs text-alabaster-400 font-light pl-3">
                      {item.detail}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

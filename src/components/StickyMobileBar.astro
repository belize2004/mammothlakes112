---
import { property } from '../data/property';
---

<div class="fixed bottom-0 left-0 right-0 z-40 md:hidden bg-charcoal-950/95 backdrop-blur-xl border-t border-white/15 px-4 py-3 shadow-2xl flex items-center justify-between">
  <div>
    <span class="block text-[10px] font-mono text-alabaster-400 uppercase tracking-wider">Direct Rate</span>
    <span class="font-mono text-sm font-bold text-white">{property.specs.baseRate}</span>
  </div>
  <div class="flex items-center gap-2">
    <a 
      href={`tel:${property.contact.phone}`} 
      class="p-2.5 rounded-alpine bg-charcoal-900 border border-white/15 text-alabaster-200 hover:text-white"
      aria-label="Call Hosts"
    >
      <svg class="w-4 h-4 text-alpenglow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
    </a>
    <a 
      href="/#booking" 
      class="px-5 py-2.5 rounded-alpine bg-alpenglow hover:bg-alpenglow-hover font-mono text-xs font-semibold uppercase tracking-wider text-white shadow-md flex items-center gap-1.5"
    >
      Book Direct
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</div>

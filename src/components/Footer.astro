---
import { property } from '../data/property';
---

<footer class="bg-charcoal-950 text-alabaster-300 border-t border-white/10 pt-16 pb-24 md:pb-16 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Column 1: Brand & Coordinates -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 border border-white/20 bg-charcoal-800 flex items-center justify-center rounded-alpine">
            <svg class="w-4 h-4 text-alpenglow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <span class="font-display font-bold text-lg text-white">MAMMOTH CONESTOGA 112</span>
        </div>
        <p class="text-xs font-light text-alabaster-400 leading-relaxed">
          {property.subheadline}
        </p>
        <div class="text-[11px] font-mono text-alabaster-400 space-y-1 pt-2 border-t border-white/5">
          <div>{property.coordinates.display}</div>
          <div>ELEVATION: {property.elevation}</div>
          <div class="text-alpenglow font-semibold">PERMIT: {property.permitNumber}</div>
        </div>
      </div>

      <!-- Column 2: Quick Navigation -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-widest text-white mb-4 pb-1 border-b border-white/10">
          The Experience
        </h4>
        <ul class="space-y-2 text-xs font-mono text-alabaster-400">
          <li><a href="/#residence" class="hover:text-alpenglow transition-colors">The Residence & Photos</a></li>
          <li><a href="/#highlights" class="hover:text-alpenglow transition-colors">Basecamp Highlights</a></li>
          <li><a href="/#location" class="hover:text-alpenglow transition-colors">Location & Proximity</a></li>
          <li><a href="/#reviews" class="hover:text-alpenglow transition-colors">Guest Reviews (4.91★)</a></li>
          <li><a href="/#story" class="hover:text-alpenglow transition-colors">Meet Rog & Steph</a></li>
          <li><a href="/#faq" class="hover:text-alpenglow transition-colors">Arrival Guide & FAQ</a></li>
        </ul>
      </div>

      <!-- Column 3: Direct Host Contact -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-widest text-white mb-4 pb-1 border-b border-white/10">
          Direct Host Contact
        </h4>
        <div class="space-y-3 text-xs">
          <div>
            <span class="text-alabaster-400 font-mono block">Direct Telephone</span>
            <a href={`tel:${property.contact.phone}`} class="font-mono text-white hover:text-alpenglow transition-colors">
              {property.contact.phoneFormatted}
            </a>
          </div>
          <div>
            <span class="text-alabaster-400 font-mono block">Host Inquiries</span>
            <a href={`mailto:${property.contact.email}`} class="font-mono text-white hover:text-alpenglow transition-colors break-all">
              {property.contact.email}
            </a>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <a 
              href={property.contact.facebook} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 rounded-alpine bg-white/5 hover:bg-white/15 border border-white/10 text-white transition-colors"
              aria-label="Facebook Page"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a 
              href={property.contact.instagram} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 rounded-alpine bg-white/5 hover:bg-white/15 border border-white/10 text-white transition-colors"
              aria-label="Instagram Page"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Column 4: Referral to Friend's 2BR Unit -->
      <div class="p-5 rounded-alpine bg-charcoal-900 border border-white/10 space-y-3">
        <span class="text-[10px] font-mono text-alpenglow uppercase tracking-widest block">
          NEED A LARGER SPACE?
        </span>
        <h5 class="font-display font-semibold text-sm text-white">Mammoth Lakes Tyrol 103</h5>
        <p class="text-xs text-alabaster-400 font-light leading-relaxed">
          Traveling with a bigger family or group? Check out our close friend's 2-bedroom mountain condo just down the road.
        </p>
        <a 
          href={property.contact.sisterProperty} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-white hover:text-alpenglow transition-colors"
        >
          View Tyrol 103 Details &rarr;
        </a>
      </div>

    </div>

    <!-- Bottom Copyright & Compliance -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-alabaster-500 gap-4 text-center sm:text-left">
      <div>
        &copy; {new Date().getFullYear()} {property.name}. All Rights Reserved. &bull; Permit #{property.permitNumber}
      </div>
      <div>
        Direct Direct-Booking Engine Powered by OwnerRez
      </div>
    </div>

  </div>
</footer>

---
import { featuredReviews, reviewsSummary } from '../data/reviews';
import { property } from '../data/property';
---

<section id="reviews" class="py-20 lg:py-28 bg-charcoal-950 border-t border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-6 border-b border-white/10 gap-6">
      <div>
        <div class="text-xs font-mono text-alpenglow uppercase tracking-widest mb-3 flex items-center gap-2">
          <span>08 // VERIFIED GUEST TESTIMONIALS</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
          Loved by Adventurers & <br class="hidden sm:inline" />
          <span class="italic font-normal text-alabaster-200">Mountain Pups Alike.</span>
        </h2>
      </div>

      <!-- Rating Pill -->
      <div class="flex items-center gap-4 bg-charcoal-900 border border-white/15 px-5 py-3 rounded-alpine">
        <div class="text-3xl font-display font-bold text-white flex items-center gap-1">
          <span class="text-amber-400">★</span>
          <span>{reviewsSummary.averageRating}</span>
        </div>
        <div class="text-xs font-mono text-alabaster-400 border-l border-white/10 pl-4">
          <span class="text-white font-semibold block">{reviewsSummary.totalReviews}+ Verified Reviews</span>
          <span>{reviewsSummary.recommendationPercentage}% Recommended</span>
        </div>
      </div>
    </div>

    <!-- Featured Reviews Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {featuredReviews.map((rev) => (
        <div class="bg-charcoal-900 border border-white/10 rounded-alpine p-7 flex flex-col justify-between hover:border-white/20 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1 text-amber-400 text-sm">
                {"★".repeat(rev.rating)}
              </div>
              <span class="text-[10px] font-mono text-alabaster-400 uppercase tracking-wider">
                {rev.source} &bull; {rev.date}
              </span>
            </div>
            <p class="text-sm sm:text-base text-alabaster-200 font-light leading-relaxed mb-6 italic">
              "{rev.comment}"
            </p>
          </div>
          <div class="flex items-center justify-between pt-4 border-t border-white/5 text-xs font-mono">
            <span class="font-bold text-white">{rev.author}</span>
            <span class="text-alabaster-400">{rev.location}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Live OwnerRez Reviews Widget Stream Container -->
    <div class="bg-charcoal-900 border border-white/15 rounded-alpine p-6 sm:p-8 shadow-alpine">
      <div class="mb-6 pb-4 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <span class="text-[10px] font-mono text-alpenglow uppercase tracking-widest block">FULL REVIEWS FEED</span>
          <h3 class="font-display text-xl font-bold text-white">Live Verified Guest Archive</h3>
        </div>
        <span class="text-xs font-mono text-alabaster-400">Directly synchronized via OwnerRez</span>
      </div>

      <div class="ownerrez-container bg-white rounded-alpine p-4 text-charcoal-900 shadow-inner overflow-hidden min-h-[300px]">
        <div 
          class="ownerrez-widget" 
          data-propertyId={property.ownerRez.propertyId} 
          data-widget-type="Reviews" 
          data-widgetId={property.ownerRez.reviewsWidgetId}
        ></div>
      </div>
    </div>

  </div>
</section>
